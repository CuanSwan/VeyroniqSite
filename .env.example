# Copy this file to .env for local `netlify dev` testing.
# In production, set these under Site configuration > Environment variables
# in the Netlify dashboard — never commit real values to the repo.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that contact form enquiries should be delivered to
CONTACT_TO_EMAIL=

# Optional. Must be an address on a domain verified in Resend, e.g.
# "Veyroniq <hello@veyroniq.com>". Defaults to Resend's shared testing
# address (onboarding@resend.dev), which can only deliver to the email
# address on your own Resend account — fine for testing, not for real
# enquiries until you verify a sending domain.
CONTACT_FROM_EMAIL=
