# Copy this file to .dev.vars for local `wrangler dev` testing.
# For the deployed Worker, set these as secrets instead (never committed):
#   wrangler secret put RESEND_API_KEY
#   wrangler secret put CONTACT_TO_EMAIL
#   wrangler secret put CONTACT_FROM_EMAIL   (optional)

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that contact form enquiries should be delivered to
CONTACT_TO_EMAIL=

# Optional. Must be an address on a domain verified in Resend, e.g.
# "Veyroniq <hello@veyroniq.com>". Defaults to Resend's shared testing
# address (onboarding@resend.dev), which can only deliver to the email
# address on your own Resend account — fine for testing, not for real
# enquiries until you verify a sending domain.
CONTACT_FROM_EMAIL=

# Optional. Restricts which site is allowed to call this Worker. Once you
# know your real domain, set this and redeploy — until then it defaults
# to allowing any origin.
ALLOWED_ORIGIN=
